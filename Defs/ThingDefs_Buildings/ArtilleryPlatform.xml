<?xml version="1.0" encoding="UTF-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>ACP_ArtilleryPlatform</defName>
    <label>artillery command platform</label>
    <description>A stationary artillery rig that can be used to remotely bombard world map targets within 12 tiles.</description>
    <graphicData>
      <texPath>Things/Building/Security/Mortar</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <size>(3,3)</size>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>70</pathCost>
    <fillPercent>0.5</fillPercent>
    <statBases>
      <WorkToBuild>20000</WorkToBuild>
      <MaxHitPoints>350</MaxHitPoints>
      <Flammability>0.4</Flammability>
    </statBases>
    <costList>
      <Steel>280</Steel>
      <ComponentIndustrial>8</ComponentIndustrial>
      <Plasteel>60</Plasteel>
    </costList>
    <comps>
      <li Class="CompProperties_Power">
        <compClass>CompPowerTrader</compClass>
        <basePowerConsumption>600</basePowerConsumption>
      </li>
      <li Class="CompProperties_Refuelable">
        <fuelLabel>shells</fuelLabel>
        <fuelCapacity>3</fuelCapacity>
        <consumeFuelOnlyWhenUsed>true</consumeFuelOnlyWhenUsed>
        <fuelConsumptionPerTickInRain>0</fuelConsumptionPerTickInRain>
        <fuelConsumptionPerUse>1</fuelConsumptionPerUse>
        <initialFuelPercent>1</initialFuelPercent>
        <fuelFilter>
          <thingDefs>
            <li>MortarShell</li>
          </thingDefs>
        </fuelFilter>
      </li>
    </comps>
    <building>
      <isEdifice>true</isEdifice>
      <claimable>true</claimable>
      <leaveResourcesWhenKilled>true</leaveResourcesWhenKilled>
    </building>
    <designationCategory>Security</designationCategory>
    <minifiedDef>MinifiedThing</minifiedDef>
    <researchPrerequisites>
      <li>ACP_ArtilleryCommand</li>
    </researchPrerequisites>
    <constructEffect>ConstructMetal</constructEffect>
    <uiIconPath>Things/Building/Security/Mortar</uiIconPath>
    <thingClass>RimWorldArtillery.Building_MapArtillery</thingClass>
  </ThingDef>
</Defs>
